{
  "name": "@bis/slidev-documentation",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config comparison.vite.config.mjs --port 3032 --strictPort",
    "dev:comparison": "vite --config comparison.vite.config.mjs --port 3032 --strictPort",
    "predev:stable-preview": "node scripts/patch-slidev-editor-autosave.mjs",
    "dev:stable-preview": "node scripts/slidev-live-preview.mjs start --duration-hours 12",
    "preview:status": "node scripts/slidev-live-preview.mjs status",
    "verify:live-preview:proxy": "node --test scripts/test-live-preview-proxy.mjs",
    "verify:live-preview:fast": "node --test scripts/test-live-preview-manifest.mjs scripts/test-live-preview-policy.mjs scripts/test-live-preview-readiness.mjs scripts/test-live-preview-coherence.mjs scripts/test-live-preview-diagnostics.mjs && node scripts/verify-live-preview.mjs --profile fast",
    "verify:live-preview": "node scripts/verify-live-preview.mjs --profile integration",
    "verify:live-preview:soak": "node scripts/slidev-live-preview.mjs soak --duration-hours 12",
    "dev:seriph": "slidev slides.md --theme seriph --port 3042 --base /slidev/seriph/",
    "dev:apple-basic": "slidev slides.md --theme apple-basic --port 3043 --base /slidev/apple-basic/",
    "dev:dracula": "slidev slides.md --theme dracula --port 3044 --base /slidev/dracula/",
    "dev:template": "slidev template-deck.md --theme default --port 3045 --base /slidev/template/",
    "dev:modrian-template-1": "slidev template-deck.md --theme ./themes/mondrian-classic --port 3046 --base /slidev/modrian-template-1/",
    "dev:modrian-template-2": "slidev modrian-template-2.md --theme ./themes/mondrian-night --port 3047 --base /slidev/modrian-template-2/",
    "dev:modrian-template": "slidev modrian-template.md --theme ./themes/mondrian-final --port 3049 --base /slidev/modrian-template/",
    "predev:modrian-template": "npm run sync:layout-mappings",
    "dev:modrian-template-3": "slidev template-deck.md --theme ./themes/mondrian-signal --port 3048 --base /slidev/modrian-template-3/",
    "dev:blockchain-for-game-master-deck": "slidev blockchain-for-game-master-deck.md --theme ./themes/mondrian-final --port 3051 --base /slidev/blockchain-for-game-master-deck/",
    "predev:blockchain-for-game-master-deck": "npm run sync:layout-mappings",
    "dev:tease-subdeck": "slidev tease-subdeck.md --theme ./themes/mondrian-final --port 3053 --base /slidev/tease-subdeck/",
    "predev:tease-subdeck": "npm run sync:layout-mappings",
    "dev:outro": "slidev outro.md --theme ./themes/mondrian-final --port 3052 --base /slidev/outro/",
    "dev:live-preview-fixture": "slidev fixtures/live-preview-fixture.md --theme default --port 3054 --base /slidev/live-preview-fixture/",
    "predev:outro": "npm run sync:layout-mappings",
    "build": "npm run build:modrian-template",
    "build:modrian-template": "slidev build modrian-template.md --theme ./themes/mondrian-final --out dist/modrian-template",
    "prebuild:modrian-template": "npm run sync:layout-mappings",
    "build:blockchain-for-game-master-deck": "slidev build blockchain-for-game-master-deck.md --theme ./themes/mondrian-final --out dist/blockchain-for-game-master-deck",
    "prebuild:blockchain-for-game-master-deck": "npm run sync:layout-mappings",
    "build:tease-subdeck": "slidev build tease-subdeck.md --theme ./themes/mondrian-final --out dist/tease-subdeck",
    "prebuild:tease-subdeck": "npm run sync:layout-mappings",
    "build:outro": "slidev build outro.md --theme ./themes/mondrian-final --out dist/outro",
    "prebuild:outro": "npm run sync:layout-mappings",
    "prebuild:decks": "npm run sync:layout-mappings",
    "build:decks": "npm run verify:bullet-style && npm run build:modrian-template && npm run build:blockchain-for-game-master-deck && npm run build:tease-subdeck && npm run build:outro",
    "prebuild:public": "npm run sync:layout-mappings",
    "build:public": "slidev build modrian-template.md --theme ./themes/mondrian-final --base /blockchain-integration-service/slidev/modrian-template/ --out dist/public/modrian-template && slidev build blockchain-for-game-master-deck.md --theme ./themes/mondrian-final --base /blockchain-integration-service/slidev/blockchain-for-game-master-deck/ --out dist/public/blockchain-for-game-master-deck && slidev build tease-subdeck.md --theme ./themes/mondrian-final --base /blockchain-integration-service/slidev/tease-subdeck/ --out dist/public/tease-subdeck && slidev build outro.md --theme ./themes/mondrian-final --base /blockchain-integration-service/slidev/outro/ --out dist/public/outro && node scripts/build-public-landing.mjs",
    "sync:layout-mappings": "node scripts/sync-layout-mappings.mjs && node scripts/verify-layout-contract.mjs",
    "verify:layout-mappings:self-test": "node scripts/sync-layout-mappings.mjs --self-test",
    "verify:layout-contract": "node scripts/verify-layout-contract.mjs",
    "verify:bullet-style": "node scripts/verify-bullet-style.mjs",
    "verify:layout-contract:self-test": "node scripts/verify-layout-contract.mjs --self-test",
    "verify:rendered-layouts": "node scripts/verify-rendered-layouts.mjs",
    "export": "slidev export modrian-template.md --theme ./themes/mondrian-final"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-apple-basic": "^0.25.1",
    "@slidev/theme-bricks": "^0.25.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "playwright-chromium": "^1.63.0",
    "slidev-theme-dracula": "^0.2.5"
  }
}
