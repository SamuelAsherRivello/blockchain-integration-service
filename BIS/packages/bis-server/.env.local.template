# Private server configuration. Copy to .env.local and populate privately.
# Use a dedicated disposable test wallet, never a player or real-money wallet.
# Optional separate owner bearer credential. Keep BIS_OWNER_TOKEN stable for
# existing authorization and signing-session recovery. An explicit blank denies owner access.
# BIS_OWNER_ACCESS_TOKEN=
BIS_GAME_WALLET_MNEMONIC=
# Numbered, network-scoped slots take precedence over the legacy single local wallet.
BIS_GAME_WALLET_SIGNET_01_MNEMONIC=
BIS_GAME_WALLET_SIGNET_02_MNEMONIC=
BIS_GAME_WALLET_SIGNET_03_MNEMONIC=
BIS_GAME_WALLET_MUTINYNET_01_MNEMONIC=
BIS_GAME_WALLET_MUTINYNET_02_MNEMONIC=
BIS_GAME_WALLET_MUTINYNET_03_MNEMONIC=
BIS_GAME_WALLET_NETWORK=signet
BIS_GAME_ID=stealth-and-steel
BIS_SERVER_ENABLED=true
# Owner signing defaults to the configured public network allowlist; explicitly
# list a second test network only for a deliberately isolated local/Preview run.
BIS_OWNER_SIGNING_NETWORKS=signet
