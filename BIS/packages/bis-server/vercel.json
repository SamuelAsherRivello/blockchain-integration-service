{
  "framework": null,
  "installCommand": "cd ../../.. && npm ci",
  "buildCommand": "cd ../../.. && npm run build:vercel --workspace @bis/bis-server",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/bis/:path*",
      "destination": "/api/index"
    }
  ]
}
