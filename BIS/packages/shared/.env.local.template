# Copy/rename this file to .env.local in THIS directory, then populate locally.
# One canonical source for developer-supplied BIS secrets. Never use VITE_ keys.
# Do not commit, paste, screenshot, or print the populated file.
# Blank values deliberately disable the corresponding identity.

# Faucet server signers: never use these as Player/Game test identities.
FAUCET_SIGNET_MNEMONIC=""
FAUCET_MUTINYNET_MNEMONIC=""

# Four supplied disposable test identities. Each can be used on both networks;
# funding and history are separate on Signet and Mutinynet.
# Roles are assigned by the runner, not permanently by these slot numbers.
BIS_TEST_ACCOUNT_1_MNEMONIC=""
BIS_TEST_ACCOUNT_2_MNEMONIC=""
BIS_TEST_ACCOUNT_3_MNEMONIC=""
BIS_TEST_ACCOUNT_4_MNEMONIC=""

# Optional non-secret faucet settings (existing defaults shown).
# FAUCET_SIGNET_MAX_SATS=200000
# FAUCET_MUTINYNET_MAX_SATS=200000
# FAUCET_PORT=5190
# FAUCET_STATE_DIR=C:/private/bis-faucet-state

# Agent-created recovery material stays in the encrypted Windows-user vault.
# It is never exported here. Onboarding restores selected test identities
# privately from that vault; it does not need a separate signer secret.
